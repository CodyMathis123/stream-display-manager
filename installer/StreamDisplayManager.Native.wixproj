<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <StreamDisplayManagerVersion Condition="'$(StreamDisplayManagerVersion)' == ''">0.2.0</StreamDisplayManagerVersion>
    <OutputName>StreamDisplayManager-NativePreview-$(StreamDisplayManagerVersion)-x64</OutputName>
    <DefineConstants>StreamDisplayManagerVersion=$(StreamDisplayManagerVersion);PublishDir=$(MSBuildThisFileDirectory)..\native-output;IconPath=$(MSBuildThisFileDirectory)..\src\StreamDisplayManager.App\Assets\StreamDisplayManager.ico</DefineConstants>
    <OutputPath>$(MSBuildThisFileDirectory)..\native-installer-output\</OutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="StreamDisplayManager.Native.wxs" />
  </ItemGroup>
</Project>
